{
  "name": "rizki-motor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "analyze": "ANALYZE=true next build",
    "build": "npm run prisma:prepare && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prisma:prepare": "node prisma/prepare.js",
    "prisma:generate": "npm run prisma:prepare && prisma generate --schema=prisma/schema.prepared.prisma",
    "db:push": "npm run prisma:prepare && prisma db push --schema=prisma/schema.prepared.prisma",
    "db:migrate": "npm run prisma:prepare && prisma migrate dev --schema=prisma/schema.prepared.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "npm run prisma:prepare && prisma studio --schema=prisma/schema.prepared.prisma",
    "postinstall": "node prisma/prepare.js && prisma generate --schema=prisma/schema.prepared.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.460.0",
    "next": "^16.2.7",
    "next-auth": "^4.24.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.7",
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "@next/bundle-analyzer": "^16.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
