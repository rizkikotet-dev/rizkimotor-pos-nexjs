# Rizki Motor — Environment Variables
# Copy file ini ke .env dan isi nilai yang sesuai.
#
#   cp .env.example .env
#   npm run db:push
#   npm run db:seed
#
# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
#
# SQLite (development / Docker single-container):
#   DATABASE_URL="file:./dev.db"
#
# PostgreSQL (production / Vercel):
#   DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
#
# Cukup ganti DATABASE_URL — Prisma provider auto-detect dari URL.
# Tidak perlu file schema terpisah.

DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET WAJIB di-generate dengan perintah:
#   openssl rand -base64 32
#
# Minimal 32 karakter. JANGAN gunakan nilai contoh/default di production.
# Aplikasi akan refuse boot jika secret tidak valid di production.
NEXTAUTH_SECRET="GENERATE-DENGAN-OPENSSSL-RAND-BASE64-32-DAN-PASTIKAN-MINIMAL-32-KARAKTER"
