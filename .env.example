# Rizki Motor — Environment Variables
# Copy file ini ke .env dan isi nilai yang sesuai.

# Database (dev: SQLite, prod: PostgreSQL)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET WAJIB di-generate dengan perintah:
#   openssl rand -base64 32
# Minimal 32 karakter. JANGAN gunakan nilai contoh/default di production.
# Aplikasi akan refuse boot jika secret tidak valid di production.
NEXTAUTH_SECRET="GENERATE-DENGAN-OPENSSSL-RAND-BASE64-32-DAN-PASTIKAN-MINIMAL-32-KARAKTER"
