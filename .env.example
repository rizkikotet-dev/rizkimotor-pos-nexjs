# Rizki Motor — Environment Variables
# Copy file ini ke .env dan isi nilai yang sesuai.
#
# Untuk development (SQLite):
#   cp .env.example .env
#   npm run db:push
#
# Untuk Vercel (PostgreSQL):
#   Buat database di Neon, Supabase, atau PostgreSQL provider lain.
#   Set DATABASE_URL dengan connection string PostgreSQL.
#   Set NEXTAUTH_URL dengan domain Vercel Anda.

# ─────────────────────────────────────────────
# Database (Development — SQLite)
# ─────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# Database (Production — PostgreSQL untuk Vercel)
# Uncomment dan isi untuk deployment:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET WAJIB di-generate dengan perintah:
#   openssl rand -base64 32
#
# Minimal 32 karakter. JANGAN gunakan nilai contoh/default di production.
# Aplikasi akan refuse boot jika secret tidak valid di production.
#
# Untuk Vercel: generate secret dan set di Vercel Dashboard → Settings → Environment Variables
NEXTAUTH_SECRET="GENERATE-DENGAN-OPENSSSL-RAND-BASE64-32-DAN-PASTIKAN-MINIMAL-32-KARAKTER"
